line 51: 
line 52:     let s:timeOriginal = 'Original'
line 53: endif
line 54: 
line 55: "=================================================
line 56: " Help text
line 57: let s:helpmore = ['"    ===== Marks ===== ','" >num< : The current state','" {num} : The next redo state','" [num] : The latest state','" =num= : The diff mark','"   s   : Saved states','"   S   : The last saved state','"   ===== Hotkeys =====']
line 65: if !g:undotree_HelpLine
line 66:     let s:helpless = []
line 67: else
line 68:     let s:helpless = ['" Press ? for help.']
line 69: endif
line 70: 
line 71: "Custom key mappings: add this function to your vimrc.
line 72: "You can define whatever mapping as you like, this is a hook function which
line 73: "will be called after undotree window initialized.
line 74: "
line 75: "function g:Undotree_CustomMap()
line 76: "    map <buffer> <c-n> J
line 77: "    map <buffer> <c-p> K
line 78: "endfunction
line 79: 
line 80: " Keymap
line 81: let s:keymap = []
line 82: " action, key, help.
line 83: let s:keymap += [['Help','?','Toggle quick help']]
line 84: let s:keymap += [['Close','q','Close undotree panel']]
line 85: let s:keymap += [['FocusTarget','<tab>','Set Focus back to the editor']]
line 86: let s:keymap += [['ClearHistory','C','Clear undo history (with confirmation)']]
line 87: let s:keymap += [['TimestampToggle','T','Toggle relative timestamp']]
line 88: let s:keymap += [['DiffToggle','D','Toggle the diff panel']]
line 89: let s:keymap += [['DiffMark','=','Set the diff marker']]
line 90: let s:keymap += [['ClearDiffMark','M','Clear the diff marker']]
line 91: let s:keymap += [['NextState','K','Move to the next undo state']]
line 92: let s:keymap += [['PreviousState','J','Move to the previous undo state']]
line 93: let s:keymap += [['NextSavedState','>','Move to the next saved state']]
line 94: let s:keymap += [['PreviousSavedState','<','Move to the previous saved state']]
line 95: let s:keymap += [['Redo','<c-r>','Redo']]
line 96: let s:keymap += [['Undo','u','Undo']]
line 97: let s:keymap += [['Enter','<2-LeftMouse>','Move to the current state']]
line 98: let s:keymap += [['Enter','<cr>','Move to the current state']]
line 99: 
line 100: " 'Diff' sign definitions. There are two 'delete' signs; a 'normal' one and one
line 101: " that is used if the very end of the buffer has been deleted (in which case the
line 102: " deleted text is actually beyond the end of the current buffer version and therefore
line 103: " it is not possible to place a sign on the exact line - because it doesn't exist.
line 104: " Instead, a 'special' delete sign is placed on the (existing) last line of the
line 105: " buffer)
line 106: exe 'sign define UndotreeAdd text='.undotree_SignAdded.' texthl='.undotree_HighlightSyntaxAdd
