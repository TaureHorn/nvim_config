line 1: "=================================================
line 2: " File: autoload/undotree.vim
line 3: " Description: Manage your undo history in a graph.
line 4: " Author: David Knoble <ben.knoble@gmail.com>
line 5: " License: BSD
line 6: 
line 7: " Avoid installing twice.
line 8: if exists('g:autoloaded_undotree')
line 9:     finish
line 10: endif
line 11: let g:autoloaded_undotree = 0
line 12: 
line 13: " At least version 7.3 with 005 patch is needed for undo branches.
line 14: " Refer to https://github.com/mbbill/undotree/issues/4 for details.
line 15: " Thanks kien
line 16: if v:version < 703
line 17:     finish
line 18: endif
line 19: if (v:version == 703 && !has("patch005"))
line 20:     finish
line 21: endif
line 22: let g:loaded_undotree = 1   " Signal plugin availability with a value of 1.
line 23: 
line 24: " Short time indicators
line 25: if g:undotree_ShortIndicators == 1
line 26:     let s:timeSecond  = '1 s'
line 27:     let s:timeSeconds = ' s'
line 28: 
line 29:     let s:timeMinute  = '1 m'
line 30:     let s:timeMinutes = ' m'
line 31: 
line 32:     let s:timeHour  = '1 h'
line 33:     let s:timeHours = ' h'
line 34: 
line 35:     let s:timeDay  = '1 d'
line 36:     let s:timeDays = ' d'
line 37: 
line 38:     let s:timeOriginal = 'Orig'
line 39: else
line 40:     let s:timeSecond = '1 second ago'
line 41:     let s:timeSeconds = ' seconds ago'
line 42: 
line 43:     let s:timeMinute  = '1 minute ago'
line 44:     let s:timeMinutes = ' minutes ago'
line 45: 
line 46:     let s:timeHour  = '1 hour ago'
line 47:     let s:timeHours = ' hours ago'
line 48: 
